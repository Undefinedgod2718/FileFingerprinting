<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="PixelFont">pack://application:,,,/Assets/Fonts/#Monocraft</FontFamily>
    <FontFamily x:Key="PixelFontFallback">Courier New</FontFamily>

    <Color x:Key="McGrass">#3C8527</Color>
    <Color x:Key="McGrassShadow">#1A3A14</Color>
    <Color x:Key="McGrassShadowDeep">#0D1F0A</Color>
    <Color x:Key="McDirt">#2A2A2A</Color>
    <Color x:Key="McStone">#8B8B8B</Color>
    <Color x:Key="McStoneLight">#C6C6C6</Color>
    <Color x:Key="McStoneDark">#373737</Color>
    <Color x:Key="McSpruceBorder">#3A2E1E</Color>
    <Color x:Key="McEmerald">#00C850</Color>
    <Color x:Key="McPixelShadow">#1A1A1A</Color>

    <SolidColorBrush x:Key="McGrassBrush" Color="{StaticResource McGrass}"/>
    <SolidColorBrush x:Key="McGrassShadowBrush" Color="{StaticResource McGrassShadow}"/>
    <SolidColorBrush x:Key="McGrassShadowDeepBrush" Color="{StaticResource McGrassShadowDeep}"/>
    <SolidColorBrush x:Key="McDirtBrush" Color="{StaticResource McDirt}"/>
    <SolidColorBrush x:Key="McStoneBrush" Color="{StaticResource McStone}"/>
    <SolidColorBrush x:Key="McStoneLightBrush" Color="{StaticResource McStoneLight}"/>
    <SolidColorBrush x:Key="McStoneDarkBrush" Color="{StaticResource McStoneDark}"/>
    <SolidColorBrush x:Key="McSpruceBorderBrush" Color="{StaticResource McSpruceBorder}"/>
    <SolidColorBrush x:Key="McPixelShadowBrush" Color="{StaticResource McPixelShadow}"/>

    <ImageBrush x:Key="McTileConcreteLight" ImageSource="/Assets/Textures/concrete_light.png"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None"/>
    <ImageBrush x:Key="McTileConcreteGreen" ImageSource="/Assets/Textures/concrete_green.png"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None"/>
    <ImageBrush x:Key="McTileConcreteDark" ImageSource="/Assets/Textures/concrete_dark.png"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None"/>
    <ImageBrush x:Key="McTileStone" ImageSource="/Assets/Textures/stone.png"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None"/>
    <ImageBrush x:Key="McTileSpruce" ImageSource="/Assets/Textures/spruce.png"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None"/>
    <ImageBrush x:Key="McTileEmerald" ImageSource="/Assets/Textures/emerald.png"
                TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource McTileConcreteLight}"/>
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>

    <Style x:Key="McHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource McTileConcreteGreen}"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
    </Style>

    <Style x:Key="McHeaderTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="Black"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="McHeaderTitleShadowDeep" TargetType="TextBlock" BasedOn="{StaticResource McHeaderTitle}">
        <Setter Property="Foreground" Value="{StaticResource McGrassShadowDeepBrush}"/>
    </Style>

    <Style x:Key="McHeaderTitleShadow" TargetType="TextBlock" BasedOn="{StaticResource McHeaderTitle}">
        <Setter Property="Foreground" Value="{StaticResource McGrassShadowBrush}"/>
    </Style>

    <Style x:Key="McWhitePixelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="McWhitePixelShadow" TargetType="TextBlock" BasedOn="{StaticResource McWhitePixelText}">
        <Setter Property="Foreground" Value="{StaticResource McPixelShadowBrush}"/>
    </Style>

    <Style x:Key="McHeaderKeyModeLabel" TargetType="TextBlock" BasedOn="{StaticResource McWhitePixelText}">
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="McFieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="Foreground" Value="#1A1A1A"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="McStatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="Margin" Value="2,4,0,0"/>
    </Style>

    <Style x:Key="McDataField" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="#E8E8E8"/>
        <Setter Property="Background" Value="{StaticResource McTileConcreteDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource McStoneDarkBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource McStoneLightBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource McDataField}"/>

    <Style x:Key="McStoneButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="OuterBorder"
                            BorderBrush="{StaticResource McStoneDarkBrush}"
                            BorderThickness="3"
                            Background="{StaticResource McStoneBrush}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            ClipToBounds="True">
                        <Border BorderBrush="{StaticResource McStoneLightBrush}"
                                BorderThickness="1,1,0,0"
                                SnapsToDevicePixels="True">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}"
                                           Style="{StaticResource McWhitePixelShadow}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Margin="1,1,0,0"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}"
                                           Foreground="#FFFFFF"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           TextOptions.TextFormattingMode="Display"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource McStoneLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBorder" Property="Padding" Value="13,11,11,9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="McCopyButton" TargetType="Button" BasedOn="{StaticResource McStoneButton}">
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="MinHeight" Value="46"/>
    </Style>

    <Style x:Key="McFooterButton" TargetType="Button" BasedOn="{StaticResource McStoneButton}">
        <Setter Property="MinHeight" Value="50"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource McStoneButton}"/>

    <Style x:Key="McKeyModeCombo" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource McTileSpruce}"/>
        <Setter Property="BorderBrush" Value="{StaticResource McSpruceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <ToggleButton Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="{StaticResource McTileSpruce}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Padding="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Margin="10,4,4,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Style="{StaticResource McWhitePixelShadow}"
                                                           FontSize="19"
                                                           Margin="1,1,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Style="{StaticResource McWhitePixelText}"
                                                           FontSize="19"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                            <Path Grid.Column="1" Data="M0,0 L12,0 L6,8 Z"
                                                  Fill="White" Stretch="Uniform"
                                                  Width="12" Height="10"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{StaticResource McTileConcreteDark}"
                                    BorderBrush="{StaticResource McStoneDarkBrush}"
                                    BorderThickness="3"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="200"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Popup" Property="MinHeight" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource McKeyModeCombo}"/>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource PixelFont}"/>
        <Setter Property="FontSize" Value="19"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource McTileSpruce}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="McEmeraldProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="18"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Foreground" Value="{StaticResource McTileEmerald}"/>
        <Setter Property="Background" Value="{StaticResource McTileConcreteDark}"/>
        <Setter Property="BorderBrush" Value="{StaticResource McStoneDarkBrush}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource McEmeraldProgress}"/>

    <Style TargetType="ToolTip">
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1E1E1E"
                            BorderBrush="{StaticResource McStoneLightBrush}"
                            BorderThickness="2"
                            Padding="10,8"
                            MaxWidth="400"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{DynamicResource PixelFont}"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap"
                                   TextOptions.TextFormattingMode="Display"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
