<Window x:Class="TpFileM.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Fingerprinting"
        Icon="Assets/logo.ico"
        Height="480" Width="800"
        MinHeight="440" MinWidth="760"
        AllowDrop="True"
        DragOver="Window_OnDragOver"
        Drop="Window_OnDrop"
        Loaded="Window_OnLoaded">
    <DockPanel Background="{StaticResource McTileConcreteLight}">
        <Border DockPanel.Dock="Top" Style="{StaticResource McHeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleShadowDeepText" Style="{StaticResource McHeaderTitleShadowDeep}"
                               Margin="3,3,0,0"/>
                    <TextBlock x:Name="TitleShadowText" Style="{StaticResource McHeaderTitleShadow}"
                               Margin="1,1,0,0"/>
                    <TextBlock x:Name="TitleText" Style="{StaticResource McHeaderTitle}"/>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="KeyModeLabelShadow" Style="{StaticResource McWhitePixelShadow}"
                                   FontSize="19" Margin="1,1,0,0"/>
                        <TextBlock x:Name="KeyModeLabel" Style="{StaticResource McHeaderKeyModeLabel}"/>
                    </Grid>
                    <ComboBox x:Name="KeyModeCombo" Style="{StaticResource McKeyModeCombo}"
                              Width="280" SelectionChanged="KeyModeCombo_OnSelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="16,14,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FileNameLabel" Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource McFieldLabel}" Margin="0,0,10,10"/>
            <TextBox x:Name="FileNameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,0,0,10" IsReadOnly="True"/>

            <TextBlock x:Name="CrcKeyLabel" Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource McFieldLabel}" Margin="0,0,10,10"/>
            <TextBox x:Name="CrcKeyBox" Grid.Row="1" Grid.Column="1"
                     Margin="0,0,8,10" IsReadOnly="True"/>
            <Button x:Name="CopyCrcButton" Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource McCopyButton}" Margin="0,0,0,10"
                    Click="CopyCrc_Click"/>

            <TextBlock x:Name="ShaKeyLabel" Grid.Row="2" Grid.Column="0"
                       Style="{StaticResource McFieldLabel}" Margin="0,0,10,10"/>
            <TextBox x:Name="ShaKeyBox" Grid.Row="2" Grid.Column="1"
                     Margin="0,0,8,10" IsReadOnly="True" TextWrapping="Wrap"/>
            <Button x:Name="CopyShaButton" Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource McCopyButton}" Margin="0,0,0,10"
                    Click="CopySha_Click"/>

            <ProgressBar x:Name="HashProgress" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                         Margin="0,0,0,8" Minimum="0" Maximum="100" Value="0"
                         Style="{StaticResource McEmeraldProgress}"/>

            <TextBlock x:Name="StatusText" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                       Style="{StaticResource McStatusText}" TextWrapping="Wrap"/>

            <UniformGrid Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                         Columns="4" Margin="0,14,0,0">
                <Button x:Name="SelectFileButton" Style="{StaticResource McFooterButton}"
                        Click="SelectFile_Click"/>
                <Button x:Name="GenerateKeyButton" Style="{StaticResource McFooterButton}"
                        Click="GenerateKey_Click"/>
                <Button x:Name="SettingsButton" Style="{StaticResource McFooterButton}"
                        Click="Settings_Click"/>
                <Button x:Name="QuitButton" Style="{StaticResource McFooterButton}"
                        Click="Quit_Click"/>
            </UniformGrid>
        </Grid>
    </DockPanel>
</Window>
