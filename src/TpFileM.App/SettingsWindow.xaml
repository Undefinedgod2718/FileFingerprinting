<Window x:Class="TpFileM.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="Assets/logo.ico"
        Height="460" Width="600"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource McTileConcreteLight}">
    <Grid Margin="16" Background="{StaticResource McTileConcreteLight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LanguageLabel" Grid.Row="0" Grid.Column="0" Margin="0,0,8,12"
                   Style="{StaticResource McFieldLabel}"/>
        <ComboBox x:Name="LanguageCombo" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12"
                  SelectionChanged="LanguageCombo_OnSelectionChanged"/>

        <TextBlock x:Name="FontLabel" Text="Font" Grid.Row="1" Grid.Column="0" Margin="0,0,8,12"
                   Style="{StaticResource McFieldLabel}"/>
        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FontCombo" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="FontCombo_OnSelectionChanged">
                <ComboBoxItem Content="Monocraft (Pixel)"/>
                <ComboBoxItem Content="System (Segoe UI)"/>
                <ComboBoxItem Content="Custom (.ttf, .otf)"/>
            </ComboBox>
            <Button x:Name="FontBrowseButton" Grid.Column="1" Content="..." MinWidth="40" Click="FontBrowse_Click" Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="McpExeLabel" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8"
                   Style="{StaticResource McFieldLabel}"/>
        <TextBox x:Name="McpExeBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,8" IsReadOnly="True"/>
        <Button x:Name="McpBrowseButton" Grid.Row="2" Grid.Column="2" Content="瀏覽..." MinWidth="60" Margin="0,0,0,8" Click="McpBrowse_Click"/>

        <TextBlock x:Name="McpJsonLabel" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,8"
                   Style="{StaticResource McFieldLabel}"/>
        <TextBox x:Name="McpJsonBox" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 IsReadOnly="True" FontSize="16"/>

        <!-- Software Update Row -->
        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UpdateLabel" Grid.Column="0" VerticalAlignment="Center" 
                       Style="{StaticResource McFieldLabel}"/>
            <TextBlock x:Name="UpdateStatusText" Grid.Column="1" VerticalAlignment="Center" 
                       Style="{StaticResource McStatusText}" Foreground="{StaticResource McTileEmerald}"/>
            <Button x:Name="CheckUpdateButton" Grid.Column="2" MinWidth="90" Click="CheckUpdate_Click"/>
        </Grid>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CopyMcpJsonButton" Margin="0,0,8,0" Click="CopyMcpJson_Click"/>
            <Button x:Name="TestMcpButton" Click="TestMcp_Click"/>
        </StackPanel>

        <TextBlock x:Name="SettingsStatusText" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="0,12,0,0" TextWrapping="Wrap" Style="{StaticResource McStatusText}"/>

        <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" MinWidth="90" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
